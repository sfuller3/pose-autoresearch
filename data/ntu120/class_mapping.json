        "A053:pat on back",
        "A055:hug",
        "A056:give object"
    ],
    "aggression": [
        "A050:punch",
        "A051:kick",
        "A052:push",
        "A106:hit with object"
    ],
    "unstable_gait": [
        "A042:stagger",
        "A044:headache/fatigue"
    ],
    "wandering": [
        "A111:walk",
        "A058:walking towards",
        "A059:walking apart"
    ],
    "sitting_standing": [
        "A008:standing up",
        "A009:sitting down",
        "A010:reading",
        "A011:writing"
    ]
}
